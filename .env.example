# ==============================================================================
# mx-GPT Configuration Template
# Copy to .env and adjust values before running in production.
# ==============================================================================

# Server binding
HOST=0.0.0.0
PORT=8088

# Ollama upstream (point to http://127.0.0.1:11435 when using deploy/ollama-queue.cjs,
# or http://127.0.0.1:11434 for direct Ollama access)
OLLAMA_URL=http://127.0.0.1:11435

# Default models for Fast / Smart modes
DEFAULT_MODEL=lfm3:latest
MXGPT_FAST_MODEL=lfm3:latest
MXGPT_SMART_MODEL=inkling-2-mini:latest

# CPU thread count (match physical cores, not Hyper-Threading threads)
MXGPT_NUM_THREAD=20

# Workspace & state paths
DATA_DIR=./data
FILES_ROOT=./workspace

# Optional password protection for single-instance deployment (1 = enabled, 0 = disabled)
AUTH_REQUIRED=1
# Set a strong password on first boot or leave blank to configure in the UI
# MXGPT_PASSWORD=change-me-strong-password

# Sandbox mode (set to 1 for public / multi-user container deployments)
MXGPT_SANDBOX=0
