{
  "name": "mx-cowork",
  "version": "1.8.4",
  "description": "Native desktop AI coworker (Linux & Windows) with Fast, Smart, and Copilot orchestration",
  "homepage": "https://github.com/mxsp/mxgpt",
  "author": "FyreFly Systems <info@fyreflysystems.de>",
  "license": "MIT",
  "main": "src/electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage deb --x64",
    "build:win": "electron-builder --win zip --x64",
    "build:win-exe": "electron-builder --win nsis portable zip --x64",
    "build:all": "npm run build:linux && npm run build:win"
  },
  "build": {
    "appId": "de.fyreflysystems.mxcowork",
    "productName": "mx-Cowork",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "linux": {
      "category": "Office",
      "icon": "build/icon.png",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8"
  }
}
